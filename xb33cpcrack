        PANEL="cloudpanel"
        log_ok "${W}CloudPanel${N} ${G}✓${N}"
        ((found++))
    fi
    
    # ── Webmin ──
    if [[ -f "/etc/webmin/miniserv.conf" ]] || [[ -d "/usr/share/webmin" ]]; then
        [[ -z "$PANEL" ]] && PANEL="webmin"
        log_ok "${W}Webmin${N} ${G}✓${N}"
        ((found++))
    fi
    
    # ── ISPConfig ──
    if [[ -f "/usr/local/ispconfig/server/lib/config.inc.php" ]] || [[ -d "/usr/local/ispconfig" ]]; then
        PANEL="ispconfig"
        log_ok "${W}ISPConfig${N} ${G}✓${N}"
