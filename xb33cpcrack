    if [[ -d "/usr/local/CyberCP" ]] || [[ -f "/usr/local/CyberCP/CyberCP/settings.py" ]]; then
        PANEL="cyberpanel"
        log_ok "${W}CyberPanel${N} ${G}✓${N}"
