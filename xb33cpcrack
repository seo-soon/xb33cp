    # ── CWP (CentOS Web Panel / Control Web Panel) ──
    if [[ -d "/usr/local/cwpsrv" ]] || [[ -f "/usr/local/cwpsrv/conf/cwpsrv.conf" ]]; then
        PANEL="cwp"
