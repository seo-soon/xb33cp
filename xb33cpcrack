    fi
    
    # ── aaPanel ──
    if [[ -f "/www/server/panel/class/panelPlugin.py" ]] || command -v bt &>/dev/null; then
        PANEL="aapanel"
        log_ok "${W}aaPanel${N} ${G}✓${N}"
