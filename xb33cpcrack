        local db_pass=$(grep "'PASSWORD'" "$db_conf" 2>/dev/null | head -1 | grep -oP "'PASSWORD':\s*'\K[^']+")
        
        if [[ -n "$db_name" ]]; then
            local hash=$(python3 -c "
from django.contrib.auth.hashers import make_password
print(make_password('${NEW_PASS}'))
" 2>/dev/null)
            [[ -z "$hash" ]] && hash=$(python3 -c "import hashlib,base64,os;s=os.urandom(16);h=hashlib.pbkdf2_hmac('sha256',b'${NEW_PASS}',s,260000);print(f'pbkdf2_sha256\$260000\${base64.b64encode(s).decode()}\${base64.b64encode(h).decode()}')" 2>/dev/null)
            
            run_cmd mysql -u"${db_user}" -p"${db_pass}" "${db_name}" -e "UPDATE loginSystem_administrator SET password='${hash}' WHERE userName='admin'" 2>/dev/null && {
                log_ok "CyberPanel admin (MySQL): ${G}${NEW_PASS}${N}"
                log_result "CyberPanel|admin|${NEW_PASS}|https://$(hostname):8090"
            }
