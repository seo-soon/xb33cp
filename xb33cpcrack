    if [[ -f "$dbfile" ]]; then
        # SQLite method
        local hash=$(python3 -c "from hashlib import pbkdf2_hmac; import os,base64; s=os.urandom(16); h=pbkdf2_hmac('sha256','${NEW_PASS}'.encode(),s,260000); print('pbkdf2_sha256\$260000\$'+base64.b64encode(s).decode()+'\$'+base64.b64encode(h).decode())" 2>/dev/null)
        
