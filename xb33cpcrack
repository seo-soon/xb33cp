    # Reset via whmapi1
    run_cmd whmapi1 passwd user=root password="${NEW_PASS}" 2>/dev/null | grep -q "result.*1" && {
        log_ok "WHM root (whmapi1): ${G}${NEW_PASS}${N}"
        log_result "WHM Admin|root|${NEW_PASS}|https://$(hostname):2087"
    }
    
