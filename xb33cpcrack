root_reset_cpanel() {
    log_info "Resetting cPanel admin password..."
    
    # Reset root cPanel/WHM password
    local r1=$(run_cmd /usr/local/cpanel/scripts/realchpass root "${NEW_PASS}" 2>&1)
    if echo "$r1" | grep -qi "success\|updated\|changed"; then
        log_ok "WHM root password: ${G}${NEW_PASS}${N}"
